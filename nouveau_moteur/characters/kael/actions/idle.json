{
  "format": "moteur-animation/action-1",
  "action": "idle",
  "personnage": "kael",
  "mode": "deformation",
  "cadence": {
    "fps": 24,
    "frames_par_dessin": 3,
    "dessins_par_seconde": 8
  },
  "duree_frames": 96,
  "boucle": true,
  "dessins_cles": [
    {"vue": "face", "frame": 0},
    {"vue": "trois_quarts", "frame": 48}
  ],
  "pistes": [
    {
      "cible": "tete",
      "parametre": "yaw_deg",
      "cles": [
        {"frame": 0, "valeur": 0.0},
        {"frame": 48, "valeur": 45.0},
        {"frame": 96, "valeur": 0.0}
      ],
      "interpolation": "ease_in_out"
    },
    {
      "cible": "torse",
      "parametre": "respiration",
      "amplitude": 0.02,
      "periode_frames": 48,
      "decalage_frames": 0
    },
    {
      "cible": "cape",
      "parametre": "mouvement_secondaire",
      "ressort": {"raideur": 60.0, "amortissement": 0.25},
      "retard_dessins": 2
    },
    {
      "cible": "cheveux",
      "parametre": "mouvement_secondaire",
      "ressort": {"raideur": 80.0, "amortissement": 0.3},
      "retard_dessins": 2
    }
  ],
  "limitations": [
    "Yaw de 0 à +45° uniquement : vues face et 3/4 réelles, aucune vue de profil.",
    "Entre face et 3/4, interpolation contrôlée par fondu : fantômes possibles, à vérifier visuellement à l'étape 4.",
    "Cheveux bleus asymétriques : un miroir ne serait pas fidèle (non utilisé ici)."
  ]
}
